<%- include('../layouts/header') %>

<div class="container" style="margin-top: 32px; margin-bottom: 48px; max-width: 900px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
      <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-heading);">
        <%= post ? 'Chỉnh sửa bài viết' : 'Soạn thảo bài viết mới' %>
      </h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Hệ thống CMS Quản trị nội dung</p>
    </div>
    <a href="/admin/posts" class="btn btn-secondary">← Danh sách bài viết</a>
  </div>

  <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 32px; box-shadow: var(--shadow-sm);">
    <form action="<%= post ? '/admin/posts/edit/' + post.id : '/admin/posts/new' %>" method="POST">
      
      <div class="form-group">
        <label class="form-label">Tiêu đề bài viết *</label>
        <input type="text" name="title" class="form-control" value="<%= post ? post.title : '' %>" placeholder="Nhập tiêu đề hấp dẫn..." required autofocus>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 18px;">
        <div>
          <label class="form-label">Chuyên mục *</label>
          <select name="category_id" class="form-control" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= (post && post.category_id === cat.id) ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="form-label">Trạng thái xuất bản *</label>
          <select name="status" class="form-control" required>
            <option value="published" <%= (post && post.status === 'published') ? 'selected' : '' %>>Đã xuất bản (Công khai)</option>
            <option value="draft" <%= (post && post.status === 'draft') ? 'selected' : '' %>>Bản nháp (Chỉ admin xem)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Link ảnh bìa (Cover Image URL)</label>
        <input type="url" name="cover_image" class="form-control" value="<%= post ? post.cover_image : 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80' %>" placeholder="https://...">
      </div>

      <div class="form-group">
        <label class="form-label">Tóm tắt ngắn (Summary) *</label>
        <textarea name="summary" rows="2" class="form-control" placeholder="Tóm tắt ngắn 1-2 câu về nội dung bài viết..." required><%= post ? post.summary : '' %></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">Nội dung chi tiết (Hỗ trợ định dạng HTML) *</label>
        <textarea name="content" rows="12" class="form-control" placeholder="<p>Nhập nội dung bài viết tại đây...</p>" required style="font-family: monospace; font-size: 0.95rem;"><%= post ? post.content : '' %></textarea>
        <small style="color: var(--text-muted); display: block; margin-top: 6px;">
          Mẹo: Bạn có thể sử dụng các thẻ HTML như <code>&lt;p&gt;</code>, <code>&lt;h3&gt;</code>, <code>&lt;ul&gt;</code>, <code>&lt;code&gt;</code>, <code>&lt;pre&gt;</code> để định dạng bài viết.
        </small>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
        <a href="/admin/posts" class="btn btn-secondary">Hủy bỏ</a>
        <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">
          <%= post ? 'Lưu thay đổi' : 'Xuất bản bài viết' %>
        </button>
      </div>

    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
