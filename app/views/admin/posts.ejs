<%- include('../layouts/header') %>

<div class="container" style="margin-top: 32px; margin-bottom: 48px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
      <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-heading);">Quản lý Bài viết</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Tổng số <%= posts.length %> bài viết trong hệ thống</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/admin" class="btn btn-secondary">← Dashboard</a>
      <a href="/admin/posts/new" class="btn btn-primary">+ Thêm bài viết mới</a>
    </div>
  </div>

  <% if (msg) { %>
    <div class="alert-auto-dismiss" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px;">
      ✅ <%= msg %>
    </div>
  <% } %>

  <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden;">
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th style="width: 60px;">ID</th>
            <th>Tiêu đề bài viết</th>
            <th>Chuyên mục</th>
            <th>Tác giả</th>
            <th>Trạng thái</th>
            <th>Lượt xem</th>
            <th>Bình luận</th>
            <th>Ngày tạo</th>
            <th style="text-align: right;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if (posts.length === 0) { %>
            <tr>
              <td colspan="9" style="text-align: center; padding: 32px; color: var(--text-muted);">
                Chưa có bài viết nào trong CSDL.
              </td>
            </tr>
          <% } else { %>
            <% posts.forEach(post => { %>
              <tr>
                <td>#<%= post.id %></td>
                <td>
                  <strong><a href="/bai-viet/<%= post.slug %>" target="_blank"><%= post.title %></a></strong>
                </td>
                <td><%= post.category_name %></td>
                <td><%= post.author_name %></td>
                <td>
                  <span style="font-size: 0.75rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: <%= post.status === 'published' ? '#dcfce7; color: #166534;' : '#fef3c7; color: #92400e;' %>">
                    <%= post.status === 'published' ? 'Đã xuất bản' : 'Bản nháp' %>
                  </span>
                </td>
                <td><%= post.views %></td>
                <td><%= post.comment_count %></td>
                <td><%= new Date(post.created_at).toLocaleDateString('vi-VN') %></td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 6px;">
                    <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-secondary btn-sm">Sửa</a>
                    <form action="/admin/posts/delete/<%= post.id %>" method="POST" style="display: inline;">
                      <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
