<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <style>
    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }
    .login-card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 40px;
      width: 100%;
      max-width: 440px;
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.2);
    }
  </style>
</head>
<body>
  <div class="login-card">
    <div style="text-align: center; margin-bottom: 28px;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: #eef2ff; border-radius: 12px; margin-bottom: 12px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.5">
          <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/>
        </svg>
      </div>
      <h1 style="font-size: 1.5rem; font-weight: 800; color: #0f172a;">Quản trị Blog / CMS</h1>
      <p style="font-size: 0.85rem; color: #64748b; margin-top: 4px;">Đăng nhập để quản lý bài viết và hệ thống</p>
    </div>

    <% if (error) { %>
      <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 20px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 20px;">
        ✅ <%= success %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label class="form-label">Tên đăng nhập hoặc Email</label>
        <input type="text" name="username" class="form-control" placeholder="Nhập tên đăng nhập hoặc email" required autofocus>
      </div>

      <div class="form-group" style="margin-bottom: 24px;">
        <label class="form-label">Mật khẩu</label>
        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-weight: 600;">Đăng nhập CMS</button>
    </form>

    <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #f1f5f9; font-size: 0.85rem; color: #64748b; text-align: center;">
      <p style="margin-bottom: 8px;">Chưa có tài khoản? <a href="/admin/register" style="color: #4f46e5; font-weight: 600;">Đăng ký ngay</a></p>
      <p style="margin-top: 6px;"><a href="/">← Trở về trang Blog</a></p>
    </div>
  </div>
</body>
</html>
