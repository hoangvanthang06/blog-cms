<%- include('../layouts/header') %>

<div class="container" style="margin-top: 32px; margin-bottom: 48px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
      <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-heading);">Quản lý Bình luận</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Kiểm duyệt và phản hồi bình luận của độc giả</p>
    </div>
    <a href="/admin" class="btn btn-secondary">← Dashboard</a>
  </div>

  <% if (msg) { %>
    <div class="alert-auto-dismiss" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px;">
      <%= msg %>
    </div>
  <% } %>

  <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden;">
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Người gửi</th>
            <th>Email</th>
            <th>Nội dung</th>
            <th>Bài viết liên quan</th>
            <th>Trạng thái</th>
            <th>Ngày gửi</th>
            <th style="text-align: right;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (comments.length === 0) { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 32px; color: var(--text-muted);">
                Chưa có bình luận nào.
              </td>
            </tr>
          <% } else { %>
            <% comments.forEach(cmt => { %>
              <tr>
                <td><strong><%= cmt.author_name %></strong></td>
                <td><small><%= cmt.author_email %></small></td>
                <td style="max-width: 300px;"><%= cmt.content %></td>
                <td>
                  <a href="/bai-viet/<%= cmt.post_slug %>" target="_blank" style="font-size: 0.85rem;"><%= cmt.post_title %></a>
                </td>
                <td>
                  <span style="font-size: 0.75rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: <%= cmt.status === 'approved' ? '#dcfce7; color: #166534;' : '#fef3c7; color: #92400e;' %>">
                    <%= cmt.status === 'approved' ? 'Đã duyệt' : 'Chờ duyệt' %>
                  </span>
                </td>
                <td><small><%= new Date(cmt.created_at).toLocaleString('vi-VN') %></small></td>
                <td style="text-align: right;">
                  <form action="/admin/comments/toggle" method="POST" style="display: inline-flex; gap: 6px;">
                    <input type="hidden" name="id" value="<%= cmt.id %>">
                    <% if (cmt.status !== 'approved') { %>
                      <button type="submit" name="action" value="approve" class="btn btn-primary btn-sm">Duyệt</button>
                    <% } %>
                    <button type="submit" name="action" value="delete" class="btn btn-danger btn-sm">Xóa</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
