<%- include('../layouts/header') %>

<div class="container" style="margin-top: 32px; margin-bottom: 48px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
      <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-heading);">Quản lý Chuyên mục</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Phân loại và tổ chức nội dung bài viết</p>
    </div>
    <a href="/admin" class="btn btn-secondary">← Dashboard</a>
  </div>

  <% if (msg) { %>
    <div class="alert-auto-dismiss" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px;">
      <%= msg %>
    </div>
  <% } %>

  <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 28px;">
    <!-- Form thêm danh mục mới -->
    <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 24px; height: fit-content;">
      <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 16px; color: var(--text-heading);">Thêm chuyên mục mới</h3>
      <form action="/admin/categories/new" method="POST">
        <div class="form-group">
          <label class="form-label">Tên chuyên mục *</label>
          <input type="text" name="name" class="form-control" placeholder="Ví dụ: Điện toán đám mây" required>
        </div>

        <div class="form-group">
          <label class="form-label">Mô tả</label>
          <textarea name="description" rows="3" class="form-control" placeholder="Mô tả tóm tắt về chuyên mục..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">Tạo chuyên mục</button>
      </form>
    </div>

    <!-- Bảng danh mục hiện có -->
    <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden;">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Tên chuyên mục</th>
              <th>Slug</th>
              <th>Số bài viết</th>
              <th style="text-align: right;">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach(cat => { %>
              <tr>
                <td>#<%= cat.id %></td>
                <td><strong><%= cat.name %></strong></td>
                <td><code><%= cat.slug %></code></td>
                <td><%= cat.post_count || 0 %></td>
                <td style="text-align: right;">
                  <form action="/admin/categories/delete/<%= cat.id %>" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
