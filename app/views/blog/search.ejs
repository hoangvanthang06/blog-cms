<%- include('../layouts/header') %>

<div class="container" style="margin-top: 32px;">
  <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 24px; margin-bottom: 32px;">
    <h1 style="font-size: 1.6rem; font-weight: 700; color: var(--text-heading);">
      Kết quả tìm kiếm cho: "<span style="color: var(--primary);"><%= query %></span>"
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Tìm thấy <%= posts.length %> kết quả phù hợp</p>
  </div>

  <div class="main-layout">
    <main>
      <% if (posts.length === 0) { %>
        <div style="background: white; padding: 40px; text-align: center; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
          <p style="color: var(--text-muted); font-size: 1.1rem;">Không tìm thấy bài viết nào chứa từ khóa của bạn.</p>
          <a href="/" class="btn btn-primary btn-sm" style="margin-top: 14px;">Quay lại trang chủ</a>
        </div>
      <% } else { %>
        <div class="posts-grid">
          <% posts.forEach(post => { %>
            <article class="card">
              <div class="card-img-wrap">
                <img src="<%= post.cover_image %>" alt="<%= post.title %>">
                <span class="card-category-badge"><%= post.category_name %></span>
              </div>
              <div class="card-body">
                <h3 class="card-title"><a href="/bai-viet/<%= post.slug %>"><%= post.title %></a></h3>
                <p class="card-summary"><%= post.summary %></p>
                <div class="card-footer">
                  <div class="author-info">
                    <img src="<%= post.author_avatar %>" alt="<%= post.author_name %>" class="author-avatar">
                    <span><%= post.author_name %></span>
                  </div>
                  <div><span>👁️ <%= post.views %></span></div>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </main>

    <aside>
      <div class="sidebar-widget">
        <h3 class="widget-title">Chuyên mục</h3>
        <ul class="category-list">
          <% categories.forEach(cat => { %>
            <li class="category-item">
              <a href="/danh-muc/<%= cat.slug %>"><%= cat.name %></a>
            </li>
          <% }) %>
        </ul>
      </div>
    </aside>
  </div>
</div>

<%- include('../layouts/footer') %>
