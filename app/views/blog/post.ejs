<%- include('../layouts/header') %>

<div class="container" style="margin-top: 32px;">
  <div class="main-layout">
    <!-- Cột chính: Chi tiết bài viết -->
    <main>
      <article class="post-detail">
        <div class="post-header">
          <div style="margin-bottom: 12px;">
            <a href="/danh-muc/<%= post.category_slug %>" class="btn btn-secondary btn-sm" style="font-weight: 600;">
              <%= post.category_name %>
            </a>
          </div>
          <h1 class="post-title-main"><%= post.title %></h1>
          
          <div class="post-meta-bar">
            <div class="author-info">
              <img src="<%= post.author_avatar %>" alt="<%= post.author_name %>" class="author-avatar" style="width: 36px; height: 36px;">
              <div>
                <strong style="color: var(--text-heading); display: block;"><%= post.author_name %></strong>
                <span style="font-size: 0.8rem;"><%= post.author_role.toUpperCase() %></span>
              </div>
            </div>
            <span>📅 <%= new Date(post.created_at).toLocaleDateString('vi-VN') %></span>
            <span>👁️ <%= post.views %> lượt xem</span>
          </div>
        </div>

        <% if (post.cover_image) { %>
          <div style="margin-bottom: 28px; border-radius: var(--radius-md); overflow: hidden; max-height: 420px;">
            <img src="<%= post.cover_image %>" alt="<%= post.title %>" style="width: 100%; height: auto; object-fit: cover;">
          </div>
        <% } %>

        <!-- Tóm tắt -->
        <div style="font-size: 1.15rem; font-weight: 500; color: #475569; margin-bottom: 24px; padding: 16px; background: #f8fafc; border-left: 4px solid var(--primary); border-radius: 4px;">
          <%= post.summary %>
        </div>

        <!-- Nội dung HTML -->
        <div class="post-content">
          <%- post.content %>
        </div>
      </article>

      <!-- Khu vực Bình luận -->
      <section class="comments-box" id="comments-section">
        <h3 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 20px; color: var(--text-heading);">
          Bình luận (<%= comments.length %>)
        </h3>

        <!-- Danh sách bình luận -->
        <% if (comments.length === 0) { %>
          <p style="color: var(--text-muted); margin-bottom: 24px;">Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nghĩ!</p>
        <% } else { %>
          <div style="margin-bottom: 32px;">
            <% comments.forEach(cmt => { %>
              <div class="comment-card">
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                  <strong style="color: var(--text-heading);"><%= cmt.author_name %></strong>
                  <span style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(cmt.created_at).toLocaleString('vi-VN') %></span>
                </div>
                <p style="color: #334155; font-size: 0.95rem;"><%= cmt.content %></p>
              </div>
            <% }) %>
          </div>
        <% } %>

        <!-- Form gửi bình luận -->
        <div style="background: #f8fafc; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-color);" id="comment-form">
          <h4 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; color: var(--text-heading);">Để lại bình luận của bạn</h4>
          <form action="/binh-luan" method="POST">
            <input type="hidden" name="post_id" value="<%= post.id %>">
            <input type="hidden" name="post_slug" value="<%= post.slug %>">

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
              <div>
                <label class="form-label">Họ và tên *</label>
                <input type="text" name="author_name" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required>
              </div>
              <div>
                <label class="form-label">Email *</label>
                <input type="email" name="author_email" class="form-control" placeholder="email@example.com" required>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Nội dung bình luận *</label>
              <textarea name="content" rows="4" class="form-control" placeholder="Viết phản hồi của bạn..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Gửi bình luận</button>
          </form>
        </div>
      </section>
    </main>

    <!-- Sidebar -->
    <aside>
      <div class="sidebar-widget">
        <h3 class="widget-title">Bài viết liên quan</h3>
        <% if (relatedPosts.length === 0) { %>
          <p style="font-size: 0.9rem; color: var(--text-muted);">Không có bài viết liên quan.</p>
        <% } else { %>
          <% relatedPosts.forEach(rel => { %>
            <div class="trending-item">
              <a href="/bai-viet/<%= rel.slug %>" class="trending-title"><%= rel.title %></a>
              <span class="trending-meta"><%= new Date(rel.created_at).toLocaleDateString('vi-VN') %></span>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="sidebar-widget">
        <h3 class="widget-title">Chuyên mục</h3>
        <ul class="category-list">
          <% categories.forEach(cat => { %>
            <li class="category-item">
              <a href="/danh-muc/<%= cat.slug %>"><%= cat.name %></a>
              <span class="category-pill"><%= cat.post_count || 0 %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </aside>
  </div>
</div>

<%- include('../layouts/footer') %>
