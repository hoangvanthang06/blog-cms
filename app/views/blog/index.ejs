<%- include('../layouts/header') %>

<!-- Hero Banner -->
<section class="hero">
  <div class="container hero-content">
    <h1>Nền tảng Quản trị Nội dung & Chia sẻ Kiến thức Hệ thống</h1>
    <p>Hệ sinh thái ứng dụng Web động kết nối CSDL MySQL, tối ưu Nginx Reverse Proxy, bảo mật Hardening và giám sát Prometheus + Grafana + Loki.</p>
  </div>
</section>

<div class="container">
  <div class="main-layout">
    <!-- Cột chính: Danh sách bài viết -->
    <main>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-heading);">Bài viết mới nhất</h2>
        <span style="font-size: 0.9rem; color: var(--text-muted);"><%= posts.length %> bài viết được hiển thị</span>
      </div>

      <% if (posts.length === 0) { %>
        <div style="background: white; padding: 40px; text-align: center; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
          <p style="color: var(--text-muted); font-size: 1.1rem;">Chưa có bài viết nào được xuất bản.</p>
        </div>
      <% } else { %>
        <div class="posts-grid">
          <% posts.forEach(post => { %>
            <article class="card">
              <div class="card-img-wrap">
                <img src="<%= post.cover_image || 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80' %>" alt="<%= post.title %>" loading="lazy">
                <span class="card-category-badge"><%= post.category_name %></span>
              </div>
              <div class="card-body">
                <h3 class="card-title">
                  <a href="/bai-viet/<%= post.slug %>"><%= post.title %></a>
                </h3>
                <p class="card-summary"><%= post.summary %></p>
                <div class="card-footer">
                  <div class="author-info">
                    <img src="<%= post.author_avatar %>" alt="<%= post.author_name %>" class="author-avatar">
                    <span><%= post.author_name %></span>
                  </div>
                  <div>
                    <span>👁️ <%= post.views %></span>
                  </div>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Phân trang -->
        <% if (totalPages > 1) { %>
          <div style="display: flex; justify-content: center; gap: 8px; margin-top: 36px;">
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="/?page=<%= i %>" class="btn <%= currentPage === i ? 'btn-primary' : 'btn-secondary' %> btn-sm">
                <%= i %>
              </a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </main>

    <!-- Cột phụ: Sidebar -->
    <aside>
      <!-- Danh mục -->
      <div class="sidebar-widget">
        <h3 class="widget-title">
          <span>Chuyên mục</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </h3>
        <ul class="category-list">
          <% categories.forEach(cat => { %>
            <li class="category-item">
              <a href="/danh-muc/<%= cat.slug %>"><%= cat.name %></a>
              <span class="category-pill"><%= cat.post_count || 0 %></span>
            </li>
          <% }) %>
        </ul>
      </div>

      <!-- Bài viết nổi bật -->
      <div class="sidebar-widget">
        <h3 class="widget-title">
          <span>Xem nhiều nhất 🔥</span>
        </h3>
        <div>
          <% trendingPosts.forEach(trend => { %>
            <div class="trending-item">
              <a href="/bai-viet/<%= trend.slug %>" class="trending-title"><%= trend.title %></a>
              <div class="trending-meta">
                <span><%= trend.category_name %></span> • <span><%= trend.views %> lượt xem</span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Thông tin DevOps Stack -->
      <div class="sidebar-widget" style="background: #f8fafc;">
        <h3 class="widget-title" style="font-size: 1rem;">Kiến trúc Hệ thống</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px;">Hệ thống triển khai theo mô hình Reverse Proxy chuẩn:</p>
        <ul style="font-size: 0.85rem; list-style: disc; margin-left: 18px; color: var(--text-main);">
          <li>Web Server: <strong>Nginx 1.25</strong></li>
          <li>Database: <strong>MySQL 8.0</strong></li>
          <li>Metrics: <strong>Prometheus + Grafana</strong></li>
          <li>Logs: <strong>Loki + LogQL</strong></li>
        </ul>
      </div>
    </aside>
  </div>
</div>

<%- include('../layouts/footer') %>
