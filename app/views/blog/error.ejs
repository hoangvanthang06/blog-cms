<%- include('../layouts/header') %>

<div class="container" style="margin: 60px auto; max-width: 600px; text-align: center;">
  <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 48px 32px; box-shadow: var(--shadow-md);">
    <div style="width: 64px; height: 64px; margin: 0 auto 16px; background: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    </div>
    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-heading); margin-bottom: 12px;"><%= title %></h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 24px;"><%= message %></p>
    <a href="/" class="btn btn-primary">Trở về trang chủ</a>
  </div>
</div>

<%- include('../layouts/footer') %>
